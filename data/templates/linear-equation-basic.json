{
  "id": "linear-equation-basic",
  "topic": "linear-equation",
  "grade": "middle-1",
  "questionType": "multiple_choice",
  "mathSchema": {
    "variableRanges": {
      "a": { "min": 2, "max": 10 },
      "b": { "min": 1, "max": 20 },
      "c": { "min": 1, "max": 30 }
    },
    "constraints": [
      "(c - b) % a === 0",
      "a !== 1"
    ]
  },
  "solutionTemplate": "(c - b) / a",
  "errorPatterns": [
    {
      "name": "sign-error",
      "description": "부호 실수 - 덧셈으로 계산",
      "generator": "(c + b) / a"
    },
    {
      "name": "division-error",
      "description": "나눗셈 순서 오류",
      "generator": "a / (c - b)"
    },
    {
      "name": "no-division",
      "description": "나눗셈 생략",
      "generator": "c - b"
    }
  ],
  "stemTemplates": {
    "A1": [
      "$x$를 구하세요: ${a}x + ${b} = ${c}",
      "${a}x + ${b} = ${c}일 때 $x$의 값은?"
    ],
    "A2": [
      "방정식 ${a}x + ${b} = ${c}를 풀어 $x$의 값을 구하세요.",
      "${a}x + ${b} = ${c}에서 $x$를 구하세요."
    ],
    "B1": [
      "일차방정식 ${a}x + ${b} = ${c}를 풀어 $x$의 값을 구하세요.",
      "방정식 ${a}x + ${b} = ${c}의 해를 구하세요."
    ],
    "B2": [
      "일차방정식 ${a}x + ${b} = ${c}에서 미지수 $x$의 값을 구하세요.",
      "방정식 ${a}x + ${b} = ${c}를 만족하는 $x$의 값을 구하세요."
    ]
  }
}
